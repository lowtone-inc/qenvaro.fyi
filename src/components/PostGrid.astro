---
import PostCard from './PostCard.astro';
import type { Post } from '@/lib/posts';

export interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 ? (
    <div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div>
  ) : (
    <p class="empty">아직 글이 없습니다.</p>
  )
}
