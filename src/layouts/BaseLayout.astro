---
import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/config';
import { withBase } from '@/lib/url';
import type { ArticleMeta } from '@/components/BaseHead.astro';

export interface Props {
  title?: string;
  description?: string;
  article?: ArticleMeta;
  noindex?: boolean;
}

const { title, description, article, noindex } = Astro.props;

// 페인트 전에 저장된 테마를 적용해 깜빡임을 막는다.
const themeBootScript = `(()=>{try{const t=localStorage.getItem('theme');if(t)document.documentElement.dataset.theme=t;}catch(e){}})();`;
---

<!doctype html>
<html lang={SITE.locale.split('-')[0]}>
  <head>
    <BaseHead title={title} description={description} article={article} noindex={noindex} />
    <script is:inline set:html={themeBootScript} />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline src={withBase('/assets/main.js')} defer></script>
  </body>
</html>
